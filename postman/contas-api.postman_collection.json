{
  "info": {
    "name": "Contas API — Gestão de Contas Bancárias",
    "description": "Correr pela ordem. O login guarda o token automaticamente nas variáveis da colecção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "clientToken",
